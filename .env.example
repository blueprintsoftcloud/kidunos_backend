# Copy this file to .env and fill in real values before running the app.
# See src/config/env.ts for the full validation schema — the app refuses to start
# if a required variable is missing or malformed.

NODE_ENV=development
PORT=5000
# Comma-separated list of origins allowed to call this API with credentials.
ALLOWED_ORIGINS=http://localhost:5173
STOREFRONT_URL=http://localhost:5173

# ── Database (MongoDB Atlas) ─────────────────────────────────────────────────
# MONGO_URL is required and is the only var Mongoose reads.
MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>
DATABASE_URL=

# ── JWT & Session / OTP Cryptography ───────────────────────────────────────────
# Generate distinct strong random secrets (>= 32 chars in production):
#   openssl rand -hex 32
JWT_SECRET=efcb67570dec26cfdf3ddcdbcaf8944abcfab3c02f7e26a2ff44ab7c3b9d5c79
REFRESH_TOKEN_SECRET=1beb660b46fd9e749d7b9ff0818daf699baeaab91a17ab003945bca69962de48
OTP_HMAC_SECRET=9bd85bf85f55a4546693284254ba14263af4ea1c544c2c61a1f50e9c41ac05ab
# Dedicated 32-byte AES-256-GCM key (exact 64 hex chars) for encrypted EmailOutbox payloads (PR 2+):
# Must be distinct from OTP_HMAC_SECRET, JWT_SECRET, and REFRESH_TOKEN_SECRET.
OUTBOX_ENC_KEY=4b4850199f4111f4ef7bc3f4f2de59323be9429524e270323a740ee90c84385a
# Number of trusted reverse-proxy hops (Nginx/Cloudflare) in front of Express / Socket.IO:
TRUST_PROXY_HOPS=1

# ── Feature Flags & EmailOutbox Worker (PR 2+) ─────────────────────────────────
# Safe progressive cutover flag for customer Email OTP login/signup UI & endpoints.
# Keep "false" until EMAIL_OUTBOX / MSG91 template testing is signed off.
CUSTOMER_EMAIL_OTP_ENABLED=false
EMAIL_OUTBOX_POLL_MS=2000
EMAIL_OUTBOX_BATCH_SIZE=10
EMAIL_OUTBOX_LOCK_TIMEOUT_MS=60000
EMAIL_OUTBOX_MAX_ATTEMPTS=3

# ── System alert recipient (health monitor "[System Alert]" emails) ───────────
EMAIL_USER=

# ── Storage: "r2" (Cloudflare R2 - recommended) or "cloudinary" ─────────────
STORAGE_PROVIDER=r2

# ── Cloudflare R2 (10GB free, $0 egress fees forever) ─────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Custom domain connected in R2 (e.g. https://media.yourdomain.com or https://pub-xxx.r2.dev)
R2_PUBLIC_DOMAIN=

# ── Cloudinary (legacy image storage) ─────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Nomod hosted checkout (keep the API key server-side; never expose it to Vite) ──
NOMOD_API_KEY=

# ── Legacy Razorpay credentials — only needed for historical pending orders ──────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay Webhook Secret (configured in Razorpay Dashboard > Settings > Webhooks)
# If left commented out / blank, the system automatically uses RAZORPAY_KEY_SECRET as fallback.
# RAZORPAY_WEBHOOK_SECRET=your_custom_webhook_secret_here

# ── MSG91 (mobile OTP widget) ───────────────────────────────────────────────────
MSG91_AUTH_KEY=
MSG91_TOKEN_AUTH=
MSG91_WIDGET_ID=

# ── MSG91 Email API (transactional email — OTP, order confirmation, order
# status, system alerts) — replaces the old SMTP transport. MSG91_EMAIL_DOMAIN
# must be verified in MSG91's Email dashboard; MSG91_EMAIL_FROM must be an
# address on that domain. Each MSG91_TEMPLATE_* is a template id created in
# MSG91's dashboard (Email > Templates) — see src/config/mailer.ts for the
# {{variable}} placeholders each one needs. Leave blank and email sending
# no-ops with a warning log instead of failing requests.
MSG91_EMAIL_DOMAIN=
MSG91_EMAIL_FROM=
MSG91_EMAIL_FROM_NAME=blueprint_crm
MSG91_TEMPLATE_OTP=
MSG91_TEMPLATE_ORDER_CONFIRMATION=
MSG91_TEMPLATE_ORDER_STATUS=
MSG91_TEMPLATE_HEALTH_ALERT=

# ── Shipping ──────────────────────────────────────────────────────────────────
WAREHOUSE_LAT=25.2048
WAREHOUSE_LNG=55.2708

# ── Background job / inventory alert config ────────────────────────────────────
LOW_STOCK_THRESHOLD=5

# ── Backup / disaster recovery ─────────────────────────────────────────────────
BACKUP_DIR=./backups
BACKUP_RETENTION_COUNT=14

# ── CSRF ──────────────────────────────────────────────────────────────────────
# Double-submit CSRF uses CSPRNG per-session cookies directly; CSRF_SECRET is optional/legacy:
CSRF_SECRET=

# ── Archival job retention windows (optional — sensible defaults if unset) ────
AUDIT_LOG_RETENTION_MONTHS=6
ORDER_RETENTION_YEARS=2
